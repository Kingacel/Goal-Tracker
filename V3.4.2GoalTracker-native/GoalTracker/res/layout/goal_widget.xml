<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp"
    android:background="@drawable/widget_bg">

    <!-- Header: "+" adds a goal, "•••" opens the widget menu. 48dp wide touch targets. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="end|center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/w_add"
            android:layout_width="48dp"
            android:layout_height="44dp"
            android:gravity="center"
            android:contentDescription="Add goal"
            android:text="+"
            android:textColor="@color/w_text"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/w_more"
            android:layout_width="48dp"
            android:layout_height="44dp"
            android:gravity="center"
            android:contentDescription="More options"
            android:text="&#8226;&#8226;&#8226;"
            android:textColor="@color/w_text"
            android:textSize="20sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Scrollable goal list (touch and swipe up/down) -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ListView
            android:id="@+id/w_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:divider="@null"
            android:dividerHeight="0dp"
            android:scrollbars="none"
            android:overScrollMode="never" />

        <TextView
            android:id="@+id/w_empty"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="No goals yet – tap +"
            android:textColor="@color/w_text"
            android:textSize="16sp"
            android:textStyle="bold" />
    </FrameLayout>
</LinearLayout>
